{"transcript":"ˈprau̯kɐ","exists":true,"definitions":["Виправлення помилок, неточностей у тексті, документі тощо.","Дія або процес виправлення чогось.","Результат виправлення."],"examples":["Правка тексту зайняла багато часу.","Він вніс правки до звіту.","Остаточна правка була зроблена вчора."],"lemma":"правка","lemmaPos":"noun","synonyms":["виправлення","корекція","редагування"],"number":"singular","pluralForm":"правки","gender":"feminine","source":"правка","frequency":3}